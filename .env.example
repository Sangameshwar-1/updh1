# Copy to .env.local and fill in. Never commit .env.local.

# Public: appears in every delivery URL, safe in the browser bundle.
VITE_CLOUDINARY_CLOUD_NAME=

# Server only: read by api/sign.ts. No VITE_ prefix, ever.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server only: bearer token a curator presents to /api/sign.
UPLOAD_ACCESS_TOKEN=

# Only if browser-side unsigned uploads are used. Must be a restricted preset.
VITE_CLOUDINARY_UPLOAD_PRESET=
